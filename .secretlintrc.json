{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          { "name": "JWT (e.g. Supabase anon or service_role key)", "pattern": "/eyJ[A-Za-z0-9_-]{10,}[.]eyJ[A-Za-z0-9_-]{10,}[.][A-Za-z0-9_-]{10,}/" },
          { "name": "Supabase secret key", "pattern": "/sb_secret_[A-Za-z0-9_-]{10,}/" },
          { "name": "Stripe live key", "pattern": "/[sr]k_live_[A-Za-z0-9]{20,}/" },
          { "name": "AWS access key id", "pattern": "/(?:AKIA|ASIA)[A-Z0-9]{16}/" },
          { "name": "Database URL with a password", "pattern": "/postgres(?:ql)?:[/][/][^: /]+:(?!<|[[]|life_dev@|YOUR|PASSWORD)[^@ ]{6,}@/" }
        ]
      }
    }
  ]
}
