# Copy to the repo-root .env.local (git-ignored) and fill in. Both apps read it:
#   web: apps/web/next.config.ts   api: apps/api/src/env.ts (root .env.local wins over apps/api/.env)
# See docs/guides/AUTH_SETUP.md. Never put real values in this file.
#
# Other environments: keep a separate git-ignored file (e.g. .env.preprod.local, created by
# `node scripts/preprod-secrets.mjs`) and point scripts at it with ENV_FILE, e.g.
#   ENV_FILE=.env.preprod.local npm run db:migrate:manual -w @life/api
# Hosted services (Vercel, Northflank) take the same names as environment variables.
# See docs/guides/DEPLOY_PREPROD.md.

# ---- Database (API + migrations) ------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
# Session pooler (port 5432) or transaction pooler (port 6543) both work; the API
# disables prepared statements automatically on 6543.
DATABASE_URL=
# Direct connection (db.<ref>.supabase.co:5432). Optional; not used by the app today.
DIRECT_URL=

# ---- API -----------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# The web app's origin(s) allowed to call the API, comma-separated, no trailing slash.
CORS_ORIGIN=http://localhost:3000
# "off" runs an API instance without the hourly reminder/finalise jobs (run only one with them on).
REMINDER_JOBS=on

# ---- Web -----------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Supabase Auth -------------------------------------------------------------
# Project Settings → API → Project URL (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API → anon / publishable key (safe in the browser; RLS blocks
# it from app tables — all data goes through our API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → JWT Keys → legacy JWT secret. The API uses it to verify HS256
# access tokens; ES256/RS256 tokens are verified via the project JWKS automatically.
SUPABASE_JWT_SECRET=
# Project Settings → API → service_role. SERVER ONLY, never in the browser.
# Not used by the app in Phase 1.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (Phase 6). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Signs the Done/Snooze buttons on notifications. Any long random string.
REMINDER_ACTION_SECRET=a-long-random-string
