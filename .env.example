# Copy values into apps/api/.env and apps/web/.env.local — see docs/DATABASE_SETUP.md

# Supabase: Project Settings → Database → Connection string
# Use "URI" + Direct connection (port 5432) for migrations & this API.
# Append ?sslmode=require if not already in the string.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Optional: require X-API-Key header on /v1/* when set
SYNC_API_KEY=

# Optional: fixed owner user UUID (otherwise created on first API use)
DEFAULT_USER_ID=

# Web — copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
